# StockPilot configuration.
#
# Copy to `.env.local` for development. In production, supply these through your
# platform's secret manager rather than a file on disk — see docs/DEPLOYMENT.md.
#
# Every variable is validated at startup by src/server/env.ts. A missing or
# malformed value stops the process immediately with a message naming every
# problem at once, rather than failing later on the first request that needs it.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string. Must include `sslmode=require` in production.
DATABASE_URL=postgres://stockpilot:stockpilot@localhost:5432/stockpilot

# Secret used to derive session and CSRF tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
# Rotating this invalidates every active session, which is the intended way to
# force a global sign-out after a suspected compromise.
SESSION_SECRET=

# ── Application ───────────────────────────────────────────────────────────────

# Absolute base URL of this deployment. Must be HTTPS in production: session
# cookies are set Secure and will not be sent over plain HTTP.
APP_URL=http://localhost:3000

# Extra browser origins permitted to call the API, comma separated.
# Leave empty unless a separate front end calls this deployment.
ALLOWED_ORIGINS=

# ── Autonomous agent ──────────────────────────────────────────────────────────

# Minutes between sweeps. Hourly suits most catalogues: forecasts do not change
# meaningfully in less time, and a shorter interval mostly costs database load.
AGENT_INTERVAL_MINUTES=60

# Master switch. `false` stops the agent process from doing anything at all —
# useful during a migration or an incident. Per-tenant pausing is a separate
# setting in the organisation record, and is the one to reach for normally.
AGENT_ENABLED=true

# ── Limits and observability ──────────────────────────────────────────────────

# Requests per minute per API key or session, per instance.
RATE_LIMIT_PER_MINUTE=600

# debug | info | warn | error
LOG_LEVEL=info
